# Apexion client config
# Copy this file to .env and edit values, or export these as real env vars.

# Manager server this client reports to. Leave SERVER_URL empty to run
# fully standalone (local .policy_cache.json only, no custom detectors,
# no dashboards) — everything below becomes a no-op in that case.
SERVER_URL=http://localhost:9000
API_TOKEN=change-me-token
CLIENT_ID=demo-laptop
CLIENT_NAME=macbook-shell

# Must match TEACH_MODEL_KEY on the server. Verifies the signed models for
# Teach Astral custom detectors before they're loaded — without a matching
# key the client refuses every custom model (fails closed, not open).
TEACH_MODEL_KEY=

CONFIG_POLL_INTERVAL=30
CONFIG_RETRY_BACKOFF=10

# Set by setup.py to match what it downloaded — DO NOT hand-edit unless you
# also re-run: python download_model.py  (or python -m spacy download <model>)
APEXION_SPACY_MODEL=en_core_web_lg
